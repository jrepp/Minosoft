  "environment": "client",
  "license": "GPL-3.0-only",
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": "1.20.4",
    "fabric-api": "=0.97.3+1.20.4",
    "entity_texture_features": "=7.0.13",
    "entity_model_features": "=3.0.17",
    "geckolib": "=4.4.4"
  },
  "custom": {
    "minosoft:modpack": {
      "packwiz": "pack.toml",
      "ladder": "ladder.tsv",
