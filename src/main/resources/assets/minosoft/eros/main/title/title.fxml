<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="de.bixilon.minosoft.gui.eros.main.title.TitleController"
           styleClass="minecraft-title-screen"
           AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
           AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
    <VBox alignment="CENTER" maxWidth="520.0" spacing="10.0">
        <Label text="MINOSOFT" styleClass="minecraft-title"/>
        <Label fx:id="splashFX" text="Minecraft-style Java client!" rotate="-7.0" styleClass="minecraft-splash">
            <VBox.margin>
                <Insets bottom="34.0" left="210.0" top="-12.0"/>
            </VBox.margin>
        </Label>
        <Button fx:id="multiplayerFX" defaultButton="true" maxWidth="360.0" minWidth="360.0"
                onAction="#openMultiplayer" text="Multiplayer" styleClass="minecraft-menu-button"/>
        <Button fx:id="profilesFX" maxWidth="360.0" minWidth="360.0"
                onAction="#openProfiles" text="Profiles &amp; Options" styleClass="minecraft-menu-button"/>
        <Button fx:id="modsFX" maxWidth="360.0" minWidth="360.0"
                onAction="#openMods" text="Mods" styleClass="minecraft-menu-button"/>
        <Button fx:id="quitFX" maxWidth="360.0" minWidth="360.0"
                onAction="#quit" text="Quit Game" styleClass="minecraft-menu-button">
            <VBox.margin>
                <Insets top="8.0"/>
            </VBox.margin>
        </Button>
    </VBox>
    <Label fx:id="versionFX" text="Minosoft" styleClass="minecraft-footer"
           StackPane.alignment="BOTTOM_LEFT">
        <StackPane.margin>
            <Insets bottom="8.0" left="10.0"/>
        </StackPane.margin>
    </Label>
    <Label text="Not affiliated with Mojang or Microsoft" styleClass="minecraft-footer"
           StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets bottom="8.0" right="10.0"/>
        </StackPane.margin>
    </Label>
</StackPane>
