if [[ -z "${MINOSOFT_JDK25_ROOT:-}" ]]; then
    if [[ "$(uname -s)" == "Darwin" ]] && command -v brew >/dev/null 2>&1; then
        minosoft_jdk25_prefix="$(brew --prefix openjdk@25 2>/dev/null)" || {
            log_error "Minosoft requires Java 25; install Homebrew openjdk@25 or set MINOSOFT_JDK25_ROOT."
            return 1
        }
        MINOSOFT_JDK25_ROOT="$minosoft_jdk25_prefix/libexec/openjdk.jdk/Contents/Home"
    else
        log_error "Set MINOSOFT_JDK25_ROOT to a Java 25 JDK before allowing this environment."
        return 1
    fi
fi

if [[ ! -x "$MINOSOFT_JDK25_ROOT/bin/java" ]] ||
    [[ "$("$MINOSOFT_JDK25_ROOT/bin/java" -version 2>&1)" != *'version "25.'* ]]; then
    log_error "MINOSOFT_JDK25_ROOT must identify a Java 25 JDK."
    return 1
fi

export JAVA_HOME="$MINOSOFT_JDK25_ROOT"
export MINOSOFT_JAVA_HOME="$MINOSOFT_JDK25_ROOT"
PATH_add "$MINOSOFT_JDK25_ROOT/bin"

if [[ -z "${MINOSOFT_VOXELIBRE_ROOT:-}" ]] && [[ -d "$PWD/../VoxeLibre" ]]; then
    export MINOSOFT_VOXELIBRE_ROOT="$PWD/../VoxeLibre"
fi
