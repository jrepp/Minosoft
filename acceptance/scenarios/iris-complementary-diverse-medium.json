{
  "name": "iris-complementary-diverse-medium",
  "steps": [
    {
      "name": "managed client and server are ready",
      "type": "wait",
      "predicate": "both.ready",
      "timeout": "3m"
    },
    {
      "name": "Iris starts persistently disabled",
      "type": "request",
      "role": "client",
      "operation": "mods.iris.presentation",
      "body": {},
      "assert": [
        { "pointer": "/enabled", "equals": false },
        { "pointer": "/installed", "equals": false }
      ]
    },
    {
      "name": "authoritative diverse medium pose is unchanged",
      "type": "request",
      "role": "client",
      "operation": "state.sample",
      "body": { "view": "client.player" },
      "assert": [
        { "pointer": "/worldState/dimension", "equals": "minecraft:overworld" },
        { "pointer": "/player/x", "equals": 32.6740054977249 },
        { "pointer": "/player/y", "equals": 78.0 },
        { "pointer": "/player/z", "equals": -608.6999999880791 },
        { "pointer": "/player/yaw", "equals": 115.75401 },
        { "pointer": "/player/pitch", "equals": 4.5429916 },
        { "pointer": "/player/gamemode", "equals": "creative" }
      ]
    },
    {
      "name": "authoritative local blocks are loaded",
      "type": "request",
      "role": "client",
      "operation": "world.blocks.sample",
      "body": {
        "min": { "x": 30, "y": 75, "z": -612 },
        "max": { "x": 35, "y": 81, "z": -606 }
      },
      "assert": [
        { "pointer": "/volume", "equals": 294 },
        { "pointer": "/notLoaded", "equals": 0 },
        { "pointer": "/palette/0", "equals": "minecraft:stone" },
        { "pointer": "/palette/2", "equals": "minecraft:grass_block[snowy=false]" }
      ]
    },
    {
      "name": "disable distant terrain for Iris isolation",
      "type": "request",
      "role": "client",
      "operation": "mods.distanthorizons.presentation",
      "body": { "enabled": false },
      "assert": [
        { "pointer": "/enabled", "equals": false },
        { "pointer": "/nonPersistent", "equals": true }
      ]
    },
    {
      "name": "prepare a deterministic static reference",
      "type": "request",
      "role": "client",
      "operation": "visual.prepare-reference",
      "body": {
        "timeOfDay": 6000,
        "clearWeather": true,
        "hideHud": true,
        "hideHitboxes": true,
        "hideClouds": true,
        "hideWorldBorder": true,
        "hideEntities": true,
        "hideParticles": true
      },
      "assert": [
        { "pointer": "/overlaysCleared", "equals": true },
        { "pointer": "/hudEnabled", "equals": false },
        { "pointer": "/time", "equals": 6000 },
        { "pointer": "/rain", "equals": 0.0 }
      ]
    },
    {
      "name": "near and distant terrain queues are idle before Iris",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.flush-idle",
      "deadlineMs": 30000,
      "body": { "condition": "ALL", "timeoutMs": 29000 },
      "assert": [
        { "pointer": "/idleState/queuedBuilds", "equals": 0 },
        { "pointer": "/idleState/outstandingBuilds", "equals": 0 },
        { "pointer": "/idleState/activeBuilds", "equals": 0 },
        { "pointer": "/idleState/pendingUploads", "equals": 0 },
        { "pointer": "/idleState/pendingSubmissions", "equals": 0 },
        { "pointer": "/idleState/pendingFences", "equals": 0 }
      ]
    },
    {
      "name": "install exact Complementary pipeline",
      "type": "request",
      "role": "client",
      "operation": "mods.iris.presentation",
      "deadlineMs": 30000,
      "body": { "enabled": true },
      "assert": [
        { "pointer": "/enabled", "equals": true },
        { "pointer": "/installed", "equals": true },
        { "pointer": "/shaderPack", "equals": "ComplementaryUnbound_r5.8.1.zip" },
        { "pointer": "/fingerprint", "equals": "385d3c1777dc297dde25dc7e5fec55234f593f824a896fd21eca3cde3e6c38a8" }
      ]
    },
    {
      "name": "reapply and verify the complete managed option set",
      "type": "request",
      "role": "client",
      "operation": "mods.iris.configure-options",
      "deadlineMs": 30000,
      "body": {
        "options": {
          "RP_MODE": "3",
          "SHADOW_QUALITY": "1",
          "CLOUD_QUALITY": "3",
          "ANISOTROPIC_FILTER": "8",
          "TAA_MODE": "0",
          "TAA_SMOOTHING": "4",
          "TAA_JITTER": "0",
          "FXAA_STRENGTH": "85",
          "FXAA_TAA_INTERACTION": "0",
          "WAVING_FOLIAGE": "false",
          "WAVING_LEAVES": "false",
          "WATER_ALPHA_MULT": "180",
          "WATER_FOG_MULT": "50",
          "WATER_BUMPINESS": "1.50",
          "UNDERWATERCOLOR_R": "110",
          "UNDERWATERCOLOR_G": "120",
          "UNDERWATERCOLOR_B": "130"
        }
      },
      "assert": [
        { "pointer": "/configured", "equals": true },
        { "pointer": "/presentationInstalled", "equals": true },
        { "pointer": "/fingerprint", "equals": "385d3c1777dc297dde25dc7e5fec55234f593f824a896fd21eca3cde3e6c38a8" },
        { "pointer": "/options/RP_MODE", "equals": "3" },
        { "pointer": "/options/TAA_MODE", "equals": "0" },
        { "pointer": "/options/FXAA_STRENGTH", "equals": "85" },
        { "pointer": "/options/WAVING_FOLIAGE", "equals": "false" },
        { "pointer": "/options/WATER_BUMPINESS", "equals": "1.50" }
      ]
    },
    {
      "name": "allow every first-frame pass to advance",
      "type": "sleep",
      "duration": "5s"
    },
    {
      "name": "capture full Iris substrate after first frames",
      "type": "request",
      "role": "client",
      "operation": "render.substrate",
      "deadlineMs": 30000,
      "body": {},
      "assert": [
        { "pointer": "/shaderGeneration", "min": 1 },
        { "pointer": "/shaderOwner", "equals": "minosoft:iris-1.7.2-shader-pipeline" },
        { "pointer": "/shaderFingerprint", "equals": "385d3c1777dc297dde25dc7e5fec55234f593f824a896fd21eca3cde3e6c38a8" },
        { "pointer": "/shaderPrograms/compiledScenePrograms", "min": 1 },
        { "pointer": "/shaderPrograms/rejectedSceneBinds", "size": 0 },
        { "pointer": "/shaderPrograms/fallbackSceneBinds", "size": 0 },
        { "pointer": "/shaderPrograms/selectedTerrainBinds/minosoft:main~1opaque~1gbuffers_terrain", "min": 1 },
        { "pointer": "/shaderPrograms/selectedTerrainBinds/minosoft:shadow~1opaque~1shadow", "min": 1 },
        { "pointer": "/shaderPrograms/selectedSceneBinds/gbuffers_hand~1ARM_SKELETAL~1ARM", "min": 1 },
        { "pointer": "/shaderPrograms/fullscreenProgramExecutions/deferred1", "min": 1 },
        { "pointer": "/shaderPrograms/fullscreenProgramExecutions/composite7", "min": 1 },
        { "pointer": "/shaderPrograms/programStages/final", "equals": "vertex,fragment" },
        { "pointer": "/shaderPrograms/activePassCutoff", "equals": null }
      ]
    },
    {
      "name": "prepare the reviewed static terrain crop",
      "type": "request",
      "role": "client",
      "operation": "visual.prepare-reference",
      "body": {
        "timeOfDay": 6000,
        "clearWeather": true,
        "hideHud": true,
        "hideHitboxes": true,
        "hideClouds": true,
        "hideWorldBorder": true,
        "hideEntities": true,
        "hideParticles": true
      }
    },
    {
      "name": "static terrain is neither blank washed out nor stippled",
      "type": "request",
      "role": "client",
      "operation": "visual.sample",
      "body": {
        "region": { "x": 2200, "y": 650, "width": 256, "height": 256 }
      },
      "assert": [
        { "pointer": "/width", "equals": 3456 },
        { "pointer": "/height", "equals": 1910 },
        { "pointer": "/region/averageLuminance", "min": 0.10 },
        { "pointer": "/region/averageLuminance", "max": 0.18 },
        { "pointer": "/region/minimumLuminance", "min": 0.05 },
        { "pointer": "/region/nearBlackPixelCount", "equals": 0 },
        { "pointer": "/region/minimumAlpha", "equals": 255 },
        { "pointer": "/region/maximumAlpha", "equals": 255 }
      ]
    },
    {
      "name": "prepare immediately before the checked terrain crop",
      "type": "request",
      "role": "client",
      "operation": "visual.prepare-reference",
      "body": {
        "timeOfDay": 6000,
        "clearWeather": true,
        "hideHud": true,
        "hideHitboxes": true,
        "hideClouds": true,
        "hideWorldBorder": true,
        "hideEntities": true,
        "hideParticles": true
      }
    },
    {
      "name": "exact Complementary static terrain crop",
      "type": "screenshot",
      "baseline": "../baselines/iris-complementary-diverse-medium/static-terrain-macos-retina-3456x1910.png",
      "sourceWidth": 3456,
      "sourceHeight": 1910,
      "region": [1900, 450, 1000, 900],
      "pixelThreshold": 12,
      "maxChangedRatio": 0.05,
      "maxMeanError": 3.0
    },
    {
      "name": "disable Iris after checked presentation",
      "type": "request",
      "role": "client",
      "operation": "mods.iris.presentation",
      "deadlineMs": 30000,
      "body": { "enabled": false },
      "assert": [
        { "pointer": "/enabled", "equals": false },
        { "pointer": "/installed", "equals": false }
      ]
    },
    {
      "name": "built in presentation remains responsive",
      "type": "request",
      "role": "client",
      "operation": "render.substrate",
      "deadlineMs": 30000,
      "body": {},
      "assert": [
        { "pointer": "/shaderGeneration", "min": 1 },
        { "pointer": "/shaderPrograms/rejectedSceneBinds", "size": 0 },
        { "pointer": "/shaderPrograms/fallbackSceneBinds", "size": 0 }
      ]
    },
    {
      "name": "restore configured distant presentation",
      "type": "request",
      "role": "client",
      "operation": "mods.distanthorizons.presentation",
      "body": { "restore": true },
      "assert": [
        { "pointer": "/override", "equals": null },
        { "pointer": "/configuredEnabled", "equals": true },
        { "pointer": "/enabled", "equals": true }
      ]
    },
    {
      "name": "restore ordinary transient presentation",
      "type": "request",
      "role": "client",
      "operation": "visual.prepare-reference",
      "body": {
        "restoreTime": true,
        "restoreWeather": true,
        "hideHud": false,
        "hideHitboxes": true,
        "hideClouds": false,
        "hideWorldBorder": false,
        "hideEntities": false,
        "hideParticles": false
      },
      "assert": [
        { "pointer": "/hudEnabled", "equals": true },
        { "pointer": "/timePrepared", "equals": false },
        { "pointer": "/weatherPrepared", "equals": false }
      ]
    }
  ]
}
