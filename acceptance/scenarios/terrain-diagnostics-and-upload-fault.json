{
  "name": "terrain-diagnostics-and-upload-fault",
  "steps": [
    {
      "name": "client has joined and rendered",
      "type": "wait",
      "predicate": "client.render-ready",
      "timeout": "3m"
    },
    {
      "name": "set deterministic flat-world terrain pose",
      "type": "request",
      "role": "client",
      "operation": "content.execute-local",
      "body": {
        "function": "minosoft:terrain_reference_pose",
        "arguments": {},
        "origin": { "x": 0.5, "y": 20.0, "z": 0.5, "yaw": 0.0, "pitch": 0.0 },
        "camera": { "x": 0.5, "y": 40.0, "z": 0.5, "yaw": 180.0, "pitch": 45.0 }
      },
      "assert": [
        { "pointer": "/camera/x", "equals": 0.5 },
        { "pointer": "/camera/y", "equals": 40.0 },
        { "pointer": "/camera/z", "equals": 0.5 }
      ]
    },
    {
      "name": "disable distant presentation for a bounded near fault boundary",
      "type": "request",
      "role": "client",
      "operation": "mods.distanthorizons.presentation",
      "body": { "enabled": false },
      "assert": [
        { "pointer": "/enabled", "equals": false },
        { "pointer": "/nonPersistent", "equals": true }
      ]
    },
    {
      "name": "terrain becomes completely idle",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.flush-idle",
      "deadlineMs": 30000,
      "body": { "condition": "ALL", "timeoutMs": 29000 },
      "assert": [
        { "pointer": "/operation", "equals": "render.terrain.flush-idle" },
        { "pointer": "/endpointGeneration", "min": 0 },
        { "pointer": "/frame", "min": 1 },
        { "pointer": "/worldEpoch", "equals": 1 },
        { "pointer": "/providerGeneration", "min": 0 },
        { "pointer": "/shaderGeneration", "min": 0 },
        { "pointer": "/layoutGeneration", "min": 0 },
        { "pointer": "/idleState/queuedBuilds", "equals": 0 },
        { "pointer": "/idleState/pendingUploads", "equals": 0 },
        { "pointer": "/idleState/retiredPages", "equals": 0 }
      ]
    },
    {
      "name": "summary advertises every bounded terrain operation",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.summary",
      "body": {},
      "assert": [
        { "pointer": "/operation", "equals": "render.terrain.summary" },
        { "pointer": "/capabilities/operationSchemaVersions/render.terrain.summary", "equals": 1 },
        { "pointer": "/capabilities/operationSchemaVersions/render.terrain.pages", "equals": 1 },
        { "pointer": "/capabilities/operationSchemaVersions/render.terrain.coverage", "equals": 1 },
        { "pointer": "/capabilities/operationSchemaVersions/render.terrain.page", "equals": 1 },
        { "pointer": "/capabilities/operationSchemaVersions/render.terrain.flush-idle", "equals": 1 },
        { "pointer": "/capabilities/operationSchemaVersions/render.terrain.compare", "equals": 1 },
        { "pointer": "/capabilities/operationSchemaVersions/render.terrain.fault", "equals": 1 },
        { "pointer": "/snapshot/pipeline/mode", "equals": "UNIFIED" }
      ]
    },
    {
      "name": "coverage reports ready near terrain",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.coverage",
      "body": {},
      "assert": [
        { "pointer": "/operation", "equals": "render.terrain.coverage" },
        { "pointer": "/coverage/stateCounts/READY", "min": 1 },
        { "pointer": "/publication/0/domain", "equals": "NEAR" },
        { "pointer": "/publication/0/views/0/missingPageCount", "equals": 0 }
      ]
    },
    {
      "name": "near page list is bounded and spatially selected",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.pages",
      "body": {
        "pageQuery": {
          "worldEpoch": 1,
          "maximumCount": 8,
          "selector": {
            "type": "AREA",
            "domain": "NEAR",
            "minimumDetailLevel": 0,
            "maximumDetailLevel": 0,
            "minimumX": -8,
            "maximumX": 8,
            "minimumY": -4,
            "maximumY": 8,
            "minimumZ": -8,
            "maximumZ": 8
          }
        }
      },
      "assert": [
        { "pointer": "/operation", "equals": "render.terrain.pages" },
        { "pointer": "/pageWindow/pages/0/page/domain", "equals": "NEAR" },
        { "pointer": "/pageWindow/pages/0/page/worldEpoch", "equals": 1 },
        { "pointer": "/pageWindow/pages/0/artifactDigest", "exists": true }
      ]
    },
    {
      "name": "near page detail exposes revision range visibility and digest",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.page",
      "body": {
        "worldEpoch": 1,
        "page": { "domain": "NEAR", "detailLevel": 0, "x": -1, "y": 0, "z": -1 }
      },
      "assert": [
        { "pointer": "/operation", "equals": "render.terrain.page" },
        { "pointer": "/found", "equals": true },
        { "pointer": "/page/source", "equals": "near-snapshot" },
        { "pointer": "/page/revisions/publicationRevision", "min": 1 },
        { "pointer": "/page/ranges/0/vertexLengthBytes", "min": 1 },
        { "pointer": "/page/visibility/0/viewId", "exists": true },
        { "pointer": "/page/artifactDigest", "exists": true }
      ]
    },
    {
      "name": "near deterministic dual build matches",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.compare",
      "body": { "fixture": "near-solid-quad" },
      "assert": [
        { "pointer": "/operation", "equals": "render.terrain.compare" },
        { "pointer": "/equivalent", "equals": true },
        { "pointer": "/published", "equals": false },
        { "pointer": "/referenceDigest", "exists": true },
        { "pointer": "/candidateDigest", "exists": true }
      ]
    },
    {
      "name": "typed upload rejection is armed",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.fault",
      "body": { "action": "ARM", "fault": "reject-next-near-upload" },
      "assert": [
        { "pointer": "/operation", "equals": "render.terrain.fault" },
        { "pointer": "/active", "equals": true },
        { "pointer": "/fault", "equals": "reject-next-near-upload" },
        { "pointer": "/restorationToken", "equals": "terrain-fault-1" }
      ]
    },
    {
      "name": "production sign mutation requests a near replacement",
      "type": "request",
      "role": "client",
      "operation": "render.prepare-sign-text",
      "body": { "enabled": true },
      "assert": [
        { "pointer": "/enabled", "equals": true },
        { "pointer": "/currentBlock", "equals": "minecraft:oak_sign" }
      ]
    },
    {
      "name": "rejected replacement retries and drains",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.flush-idle",
      "deadlineMs": 30000,
      "body": { "condition": "ALL", "timeoutMs": 29000 },
      "assert": [
        { "pointer": "/idleState/queuedBuilds", "equals": 0 },
        { "pointer": "/idleState/outstandingBuilds", "equals": 0 },
        { "pointer": "/idleState/pendingUploads", "equals": 0 }
      ]
    },
    {
      "name": "fault was consumed exactly once",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.fault",
      "body": { "action": "STATUS" },
      "assert": [
        { "pointer": "/active", "equals": false },
        { "pointer": "/consumedCount", "equals": 1 }
      ]
    },
    {
      "name": "restore fault defensively",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.fault",
      "body": { "action": "RESTORE", "restorationToken": "terrain-fault-1" },
      "assert": [
        { "pointer": "/active", "equals": false }
      ]
    },
    {
      "name": "restore sign mutation",
      "type": "request",
      "role": "client",
      "operation": "render.prepare-sign-text",
      "body": { "enabled": false },
      "assert": [
        { "pointer": "/enabled", "equals": false },
        { "pointer": "/restored", "equals": true }
      ]
    },
    {
      "name": "restored terrain drains to baseline",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.flush-idle",
      "deadlineMs": 30000,
      "body": { "condition": "ALL", "timeoutMs": 29000 },
      "assert": [
        { "pointer": "/idleState/queuedBuilds", "equals": 0 },
        { "pointer": "/idleState/pendingUploads", "equals": 0 },
        { "pointer": "/idleState/retiredBytes", "equals": 0 }
      ]
    },
    {
      "name": "restore configured distant presentation",
      "type": "request",
      "role": "client",
      "operation": "mods.distanthorizons.presentation",
      "body": { "restore": true },
      "assert": [
        { "pointer": "/enabled", "equals": true },
        { "pointer": "/override", "equals": null }
      ]
    }
  ]
}
