{
  "name": "animated-java-render-reference",
  "steps": [
    {
      "name": "client has joined and rendered",
      "type": "wait",
      "predicate": "client.render-ready",
      "timeout": "3m"
    },
    {
      "name": "clear transient UI for reference capture",
      "type": "request",
      "role": "client",
      "operation": "visual.prepare-reference",
      "body": { "hideHud": true },
      "assert": [
        { "pointer": "/overlaysCleared", "equals": true },
        { "pointer": "/hudEnabled", "equals": false }
      ]
    },
    {
      "name": "remove prior generated entities",
      "type": "request",
      "role": "client",
      "operation": "content.execute-local",
      "body": {
        "function": "animated_java:global/remove/everything",
        "arguments": {},
        "origin": { "x": 0.5, "y": 20.0, "z": 0.5, "yaw": 0.0, "pitch": 0.0 },
        "camera": { "x": 0.5, "y": 19.5, "z": 3.5, "yaw": 180.0, "pitch": 0.0 }
      },
      "assert": [
        { "pointer": "/contentGeneration", "min": 1 }
      ]
    },
    {
      "name": "summon default pose",
      "type": "request",
      "role": "client",
      "operation": "content.execute-local",
      "body": {
        "function": "aj:armor_stand_minimal/summon",
        "arguments": { "args": "{}" },
        "origin": { "x": 0.5, "y": 20.0, "z": 0.5, "yaw": 0.0, "pitch": 0.0 },
        "camera": { "x": 0.5, "y": 19.5, "z": 3.5, "yaw": 180.0, "pitch": 0.0 }
      },
      "assert": [
        { "pointer": "/executed", "equals": 7 },
        { "pointer": "/contentGeneration", "min": 1 }
      ]
    },
    {
      "name": "default pose interpolation settles",
      "type": "sleep",
      "duration": "1s"
    },
    {
      "name": "default pose",
      "type": "screenshot",
      "baseline": "../baselines/animated-java-1.10.2/default-pose-macos-retina-3456x1910.png",
      "sourceWidth": 3456,
      "sourceHeight": 1910,
      "region": [1100, 900, 550, 550],
      "pixelThreshold": 0,
      "maxChangedRatio": 0.0,
      "maxMeanError": 0.0
    },
    {
      "name": "default hierarchy",
      "type": "request",
      "role": "client",
      "operation": "state.sample",
      "body": { "view": "client.entities" },
      "assert": [
        { "pointer": "/entityCount", "equals": 9 },
        { "pointer": "/entities/1/passengers", "equals": 7 }
      ]
    },
    {
      "name": "remove default pose",
      "type": "request",
      "role": "client",
      "operation": "content.execute-local",
      "body": {
        "function": "animated_java:global/remove/everything",
        "arguments": {},
        "origin": { "x": 0.5, "y": 20.0, "z": 0.5, "yaw": 0.0, "pitch": 0.0 },
        "camera": { "x": 0.5, "y": 19.5, "z": 3.5, "yaw": 180.0, "pitch": 0.0 }
      }
    },
    {
      "name": "summon settled walk frame 10",
      "type": "request",
      "role": "client",
      "operation": "content.execute-local",
      "body": {
        "function": "aj:armor_stand_minimal/summon",
        "arguments": { "args": "{animation:\"walk\",frame:10}" },
        "origin": { "x": 0.5, "y": 20.0, "z": 0.5, "yaw": 0.0, "pitch": 0.0 },
        "camera": { "x": 0.5, "y": 19.5, "z": 3.5, "yaw": 180.0, "pitch": 0.0 }
      },
      "assert": [
        { "pointer": "/executed", "equals": 7 }
      ]
    },
    {
      "name": "walk frame interpolation settles",
      "type": "sleep",
      "duration": "1s"
    },
    {
      "name": "clear focus-loss UI before walk reference",
      "type": "request",
      "role": "client",
      "operation": "visual.prepare-reference",
      "body": { "hideHud": true, "hideHitboxes": true, "hideClouds": true },
      "assert": [
        { "pointer": "/overlaysCleared", "equals": true },
        { "pointer": "/hudEnabled", "equals": false }
      ]
    },
    {
      "name": "walk frame 10",
      "type": "screenshot",
      "baseline": "../baselines/animated-java-1.10.2/walk-frame-10-macos-retina-3456x1910.png",
      "sourceWidth": 3456,
      "sourceHeight": 1910,
      "region": [1100, 900, 550, 550],
      "pixelThreshold": 0,
      "maxChangedRatio": 0.0,
      "maxMeanError": 0.0
    },
    {
      "name": "reload mounted content",
      "type": "request",
      "role": "client",
      "operation": "render.reload-content",
      "assert": [
        { "pointer": "/generation", "min": 2 }
      ]
    },
    {
      "name": "post-reload render settles",
      "type": "sleep",
      "duration": "1s"
    },
    {
      "name": "clear focus-loss UI before recovered reference",
      "type": "request",
      "role": "client",
      "operation": "visual.prepare-reference",
      "body": { "hideHud": true, "hideHitboxes": true, "hideClouds": true },
      "assert": [
        { "pointer": "/overlaysCleared", "equals": true },
        { "pointer": "/hudEnabled", "equals": false }
      ]
    },
    {
      "name": "walk frame survives reload",
      "type": "screenshot",
      "baseline": "../baselines/animated-java-1.10.2/walk-frame-10-macos-retina-3456x1910.png",
      "sourceWidth": 3456,
      "sourceHeight": 1910,
      "region": [1100, 900, 550, 550],
      "pixelThreshold": 0,
      "maxChangedRatio": 0.0,
      "maxMeanError": 0.0
    },
    {
      "name": "capture typed GPU accounting",
      "type": "request",
      "role": "client",
      "operation": "render.substrate",
      "assert": [
        { "pointer": "/gpuResources/live", "min": 1 },
        { "pointer": "/gpuResources/types/0/type", "equals": "buffer" },
        { "pointer": "/gpuResources/types/0/live", "min": 1 },
        { "pointer": "/gpuResources/types/1/type", "equals": "vertex_array" },
        { "pointer": "/gpuResources/types/1/live", "min": 1 }
      ]
    },
    {
      "name": "remove generated hierarchy",
      "type": "request",
      "role": "client",
      "operation": "content.execute-local",
      "body": {
        "function": "animated_java:global/remove/everything",
        "arguments": {},
        "origin": { "x": 0.5, "y": 20.0, "z": 0.5, "yaw": 0.0, "pitch": 0.0 },
        "camera": { "x": 0.5, "y": 19.5, "z": 3.5, "yaw": 180.0, "pitch": 0.0 }
      }
    },
    {
      "name": "generated hierarchy is gone",
      "type": "request",
      "role": "client",
      "operation": "state.sample",
      "body": { "view": "client.entities" },
      "assert": [
        { "pointer": "/entityCount", "equals": 1 }
      ]
    }
  ]
}
