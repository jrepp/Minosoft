{
  "name": "terrain-base-near",
  "steps": [
    {
      "name": "base client has joined and rendered",
      "type": "wait",
      "predicate": "client.render-ready",
      "timeout": "3m"
    },
    {
      "name": "set deterministic near terrain pose",
      "type": "request",
      "role": "client",
      "operation": "content.execute-local",
      "body": {
        "function": "minosoft:terrain_reference_pose",
        "arguments": {},
        "origin": { "x": 0.5, "y": 20.0, "z": 0.5, "yaw": 0.0, "pitch": 0.0 },
        "camera": { "x": 0.5, "y": 40.0, "z": 0.5, "yaw": 180.0, "pitch": 45.0 }
      }
    },
    {
      "name": "base near terrain drains",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.flush-idle",
      "deadlineMs": 30000,
      "body": { "condition": "ALL", "timeoutMs": 29000 },
      "assert": [
        { "pointer": "/idleState/queuedBuilds", "equals": 0 },
        { "pointer": "/idleState/pendingUploads", "equals": 0 },
        { "pointer": "/idleState/retiredBytes", "equals": 0 }
      ]
    },
    {
      "name": "built in provider owns complete near publication",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.summary",
      "body": {},
      "assert": [
        { "pointer": "/snapshot/pipeline/mode", "equals": "UNIFIED" },
        { "pointer": "/snapshot/pipeline/nearProviderId", "equals": "minosoft:built-in-terrain" },
        { "pointer": "/snapshot/pipeline/distantProviderId", "equals": null },
        { "pointer": "/snapshot/publication/0/domain", "equals": "NEAR" },
        { "pointer": "/snapshot/publication/0/views/0/drawPageCount", "min": 1 },
        { "pointer": "/snapshot/publication/0/views/0/missingPageCount", "equals": 0 },
        { "pointer": "/snapshot/scheduling/runtime/failed", "equals": 0 }
      ]
    }
  ]
}
