{
  "name": "terrain-shader-resource-view-transition",
  "steps": [
    {
      "name": "Bliss client has joined and rendered",
      "type": "wait",
      "predicate": "client.render-ready",
      "timeout": "3m"
    },
    {
      "name": "disable shader presentation",
      "type": "request",
      "role": "client",
      "operation": "mods.iris.presentation",
      "body": { "enabled": false },
      "assert": [
        { "pointer": "/enabled", "equals": false },
        { "pointer": "/installed", "equals": false }
      ]
    },
    {
      "name": "built in transition drains",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.flush-idle",
      "deadlineMs": 30000,
      "body": { "condition": "ALL", "timeoutMs": 29000 },
      "assert": [
        { "pointer": "/idleState/queuedBuilds", "equals": 0 },
        { "pointer": "/idleState/pendingUploads", "equals": 0 }
      ]
    },
    {
      "name": "restore shader presentation",
      "type": "request",
      "role": "client",
      "operation": "mods.iris.presentation",
      "deadlineMs": 30000,
      "body": { "enabled": true },
      "assert": [
        { "pointer": "/enabled", "equals": true },
        { "pointer": "/installed", "equals": true },
        { "pointer": "/shaderPack", "exists": true }
      ]
    },
    {
      "name": "reload populated shader pipeline",
      "type": "request",
      "role": "client",
      "operation": "mods.iris.reload-shaders",
      "deadlineMs": 30000,
      "body": {},
      "assert": [
        { "pointer": "/reloaded", "equals": true },
        { "pointer": "/presentationInstalled", "equals": true },
        { "pointer": "/shaderPack", "exists": true }
      ]
    },
    {
      "name": "reload populated resource generation",
      "type": "request",
      "role": "client",
      "operation": "render.reload-content",
      "deadlineMs": 30000,
      "body": {},
      "assert": [
        { "pointer": "/accepted", "equals": true },
        { "pointer": "/generation", "min": 1 }
      ]
    },
    {
      "name": "shader and resource replacements drain",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.flush-idle",
      "deadlineMs": 30000,
      "body": { "condition": "ALL", "timeoutMs": 29000 },
      "assert": [
        { "pointer": "/idleState/queuedBuilds", "equals": 0 },
        { "pointer": "/idleState/pendingUploads", "equals": 0 },
        { "pointer": "/idleState/retiredBytes", "equals": 0 }
      ]
    },
    {
      "name": "main and shadow publish the restored generation",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.summary",
      "body": {},
      "assert": [
        { "pointer": "/snapshot/pipeline/mode", "equals": "UNIFIED" },
        { "pointer": "/snapshot/pipeline/shaderPipelineGeneration", "min": 2 },
        { "pointer": "/snapshot/publication/0/views/0/drawPageCount", "min": 1 },
        { "pointer": "/snapshot/publication/0/views/1/drawPageCount", "min": 1 },
        { "pointer": "/snapshot/publication/0/views/0/missingPageCount", "equals": 0 },
        { "pointer": "/snapshot/publication/0/views/1/missingPageCount", "equals": 0 },
        { "pointer": "/snapshot/scheduling/runtime/failed", "equals": 0 },
        { "pointer": "/snapshot/residency/0/accounting/retiredBytes", "equals": 0 },
        { "pointer": "/snapshot/submission/failedSubmissionCount", "equals": 0 }
      ]
    }
  ]
}
