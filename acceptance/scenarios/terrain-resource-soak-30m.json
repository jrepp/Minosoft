{
  "name": "terrain-resource-soak-30m",
  "duration": "30m",
  "maxCases": 128,
  "jfr": {
    "mode": "slow",
    "slowThreshold": "25m"
  },
  "steps": [
    {
      "name": "client remains joined and rendered",
      "type": "wait",
      "predicate": "client.render-ready",
      "timeout": "30s"
    },
    {
      "name": "terrain generations and providers remain valid",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.summary",
      "body": {},
      "assert": [
        { "pointer": "/endpointGeneration", "min": 0 },
        { "pointer": "/frame", "min": 1 },
        { "pointer": "/worldEpoch", "min": 1 },
        { "pointer": "/providerGeneration", "min": 0 },
        { "pointer": "/shaderGeneration", "min": 0 },
        { "pointer": "/layoutGeneration", "min": 0 },
        { "pointer": "/snapshot/pipeline/mode", "equals": "UNIFIED" },
        { "pointer": "/snapshot/scheduling/runtime/failed", "equals": 0 },
        { "pointer": "/snapshot/residency/0/accounting/retiredBytes", "equals": 0 }
      ]
    },
    {
      "name": "near publication remains complete and distant views remain populated",
      "type": "request",
      "role": "client",
      "operation": "render.terrain.coverage",
      "body": {},
      "assert": [
        { "pointer": "/coverage/stateCounts/READY", "min": 1 },
        { "pointer": "/publication/0/views/0/missingPageCount", "equals": 0 },
        { "pointer": "/publication/0/views/1/missingPageCount", "equals": 0 },
        { "pointer": "/publication/1/views/0/drawPageCount", "min": 1 },
        { "pointer": "/publication/1/views/1/drawPageCount", "min": 1 }
      ]
    },
    {
      "name": "compact runtime metrics remain readable",
      "type": "request",
      "role": "client",
      "operation": "metrics.snapshot",
      "body": {},
      "assert": [
        { "pointer": "/runtime/renderReady", "equals": true },
        { "pointer": "/runtime/terrain/failedBuilds", "equals": 0 },
        { "pointer": "/runtime/terrain/failedUploads", "equals": 0 }
      ]
    },
    {
      "name": "resource sample interval",
      "type": "sleep",
      "duration": "30s"
    }
  ]
}
